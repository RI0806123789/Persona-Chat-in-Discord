                <mxCell id="b2_start" value="&lt;b&gt;autonomous_loop（1分ごと）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;run_pending_checks()&lt;/span&gt;&lt;br&gt;全サーバーを走査（DM は対象外）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;1サーバーの失敗で他を止めない&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="80" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_guild" value="&lt;b&gt;client.get_guild() で&lt;/b&gt;&lt;br&gt;&lt;b&gt;サーバーを引けるか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="250" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_session" value="&lt;b&gt;いま配信中か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;guild_settings.autonomous_session&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※enabled の判定より先に置く&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="430" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_enabled" value="&lt;b&gt;autonomous_enabled ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（既定は無効・DB に永続化）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="610" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_quiet" value="&lt;b&gt;深夜の時間帯制限に入っているか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;_is_quiet_hours()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;既定 00:00〜05:59（Asia/Tokyo）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="770" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_vc" value="&lt;b&gt;guild.voice_client が既にあるか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※/join で人が呼んだ接続は横取りしない&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="950" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_retry" value="&lt;b&gt;開始失敗のクールダウン中か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous_start_retry_at &gt; now&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1130" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2_gauge" value="&lt;b&gt;話したいゲージを計算（0〜100）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;compute_talk_desire()&lt;/span&gt;&lt;br&gt;基礎＝無会話分 ÷ しきい値時間 ×100&lt;br&gt;＋直近180分の発言数×2（上限30）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※未観測のサーバーは 0 を返す&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※材料は on_message の mark_activity() が記録&lt;br&gt;（メンション判定より前に呼ばれる）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1310" width="400" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_gauge" value="&lt;b&gt;ゲージ ≧ 100 ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;AUTONOMOUS_GAUGE_THRESHOLD&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1520" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b2_pick" value="&lt;b&gt;行き先を選ぶ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;_pick_channel()&lt;/span&gt;&lt;br&gt;ステージ優先 → 無ければボイス&lt;br&gt;候補が複数なら random.choice&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;permissions_for(guild.me) でチャンネル単位に確認&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1690" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_pick" value="&lt;b&gt;行き先があるか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1900" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b2_connect" value="&lt;b&gt;channel.connect(timeout=30秒)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2060" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_connect" value="&lt;b&gt;接続に成功したか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2220" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_stage" value="&lt;b&gt;ステージチャンネルか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2380" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b2_prepare" value="&lt;b&gt;_prepare_stage()&lt;/b&gt;&lt;br&gt;枠が無ければ create_instance()&lt;br&gt;topic=&quot;会話相手募集中…&quot;&lt;br&gt;send_start_notification=False（通知爆撃を防ぐ）&lt;br&gt;→ member.edit(suppress=False)&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※ボイス状態が見えるまで 5回×0.5秒 待つ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2550" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_prepare" value="&lt;b&gt;発言者になれたか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2780" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b2_session" value="&lt;b&gt;AutonomousSession を作成（busy=True）&lt;/b&gt;&lt;br&gt;開始失敗の記録をクリア&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;start_failures=0 / start_retry_at=None&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="460" y="2950" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b2_opening" value="&lt;b&gt;spawn(_speak_opening())&lt;/b&gt;&lt;br&gt;第一声を生成 → 看板＋生成文をチャット投稿&lt;br&gt;（speak_text で読み上げるのは生成文だけ）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※生成に失敗しても AUTONOMOUS_OPENING_NOTICE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（会話相手募集中の看板）だけは必ず投稿する&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;finally で busy=False / last_spoke_at を必ず更新&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※投稿の直前に _is_current_session() で配信の継続を確認&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="460" y="3140" width="400" height="215" as="geometry"/>
                </mxCell>
                <mxCell id="b2_cleanup_lost" value="&lt;b&gt;セッション記録を片付ける&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;_clear_session()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※残すと is_comment_channel が真のままになり&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;自発会話の競合抑止も効き続けて&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;そのサーバーの話題提供が二度と動かなくなる&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="250" width="320" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b2_skip" value="&lt;b&gt;このサーバーは今回何もしない&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（次の見回り＝1分後に再判定）&lt;/span&gt;&lt;br&gt;・無効 ・深夜 ・/join の接続あり&lt;br&gt;・クールダウン中 ・ゲージ不足" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="950" width="320" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="b2_skip_nofail" value="&lt;b&gt;行き先が無いので何もしない&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※API を1回も叩いていないので&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;失敗としては記録しない&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（チャンネルが作られたらすぐ出られる）&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1900" width="320" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b2_fail" value="&lt;b&gt;_record_start_failure()&lt;/b&gt;&lt;br&gt;連続失敗回数 ×30分 待つ（最長4時間）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※ゲージはリセットしない&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※パネルで確定すると即座に解除される&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2220" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="b2_fail_stage" value="&lt;b&gt;ステージ準備の失敗&lt;/b&gt;&lt;br&gt;自分で開いた枠を delete →&lt;br&gt;_disconnect() で接続を切る&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（喋れないまま居座らない）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2780" width="320" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="b2_tend" value="&lt;b&gt;_tend_session()&lt;/b&gt;&lt;br&gt;配信中のサーバーの面倒を見る" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="430" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_conn_alive" value="&lt;b&gt;【停止条件⑥】&lt;/b&gt;&lt;br&gt;&lt;b&gt;ボイス接続が生きているか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;guild.voice_client.is_connected()&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B85450;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="610" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_moved" value="&lt;b&gt;【停止条件⑤】&lt;/b&gt;&lt;br&gt;&lt;b&gt;別のチャンネルへ移されたか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;voice_client.channel.id ≠ session.channel_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※追従せず畳む（開いた枠を閉じられなくなるため）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B85450;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="800" width="400" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_stopcond" value="&lt;b&gt;【停止条件①〜④】いずれかに該当するか?&lt;/b&gt;&lt;br&gt;④ パネルで無効化された&lt;br&gt;② 深夜の時間帯に入った&lt;br&gt;③ 最長 180 分を超えた&lt;br&gt;① コメントが 30 分途絶えた" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B85450;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="1000" width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_busy" value="&lt;b&gt;session.busy ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（生成・発話中なら重ねない）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="1240" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_interval" value="&lt;b&gt;前回の発話から 3 分経過したか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;AUTONOMOUS_TALK_INTERVAL_MINUTES&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="1410" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b2_monologue" value="&lt;b&gt;busy=True → spawn(_speak_monologue())&lt;/b&gt;&lt;br&gt;チャンネル履歴だけを材料に独り言を生成&lt;br&gt;→ チャット投稿 ＋ speak_text で読み上げ&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※AI モデレーションは掛けない&lt;br&gt;（_screen_speech で感情タグ除去＋NGマスクのみ）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※turn_count を進めてプロンプトへ渡す（何回目の独り言か）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※投稿の直前に _is_current_session() で配信の継続を確認&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;finally で busy=False / last_spoke_at を必ず更新&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="1600" width="400" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="b2_clear" value="&lt;b&gt;_clear_session()&lt;/b&gt;&lt;br&gt;記録の片付けのみ（締めの投稿はしない）&lt;br&gt;ゲージも空に戻す&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※戻さないと直後の見回りで再開してしまう&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="610" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b2_stop" value="&lt;b&gt;stop_session(reason, notice)&lt;/b&gt;&lt;br&gt;① 先に _clear_session（二重停止を防ぐ）&lt;br&gt;② 締めの一言を投稿（理由別に5種）&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;&amp;nbsp;&amp;nbsp;コメント途絶「反応が無くなったので…」&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;&amp;nbsp;&amp;nbsp;最長時間「長くなってきたので…」&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;&amp;nbsp;&amp;nbsp;深夜「夜も遅いので…おやすみなさい」&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;&amp;nbsp;&amp;nbsp;無効化「設定が変わったので…」&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;&amp;nbsp;&amp;nbsp;移動「別のチャンネルへ移動になったので…」&lt;/span&gt;&lt;br&gt;③ 自分で開いたステージ枠だけ delete&lt;br&gt;④ ボイス切断&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※/join・/leave からも呼ばれる（notice 無し＝締めの投稿はしない）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※例外を外へ出さない（切断まで必ず進める）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="830" width="380" height="355" as="geometry"/>
                </mxCell>
                <mxCell id="b2_wait" value="&lt;b&gt;今回は独り言を投下しない&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（次の見回り＝1分後に再判定）&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="1240" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="b2_comment_entry" value="&lt;b&gt;【別入口】on_message から&lt;/b&gt;&lt;br&gt;is_comment_channel() == True の発言&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※配信中のそのチャンネルだけ&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;メンション不要で拾う&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="1900" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_slot" value="&lt;b&gt;claim_comment_slot()&lt;/b&gt;&lt;br&gt;&lt;b&gt;前回の受付から 10 秒経過したか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;入力モデレーションより前に同期的に確保&lt;br&gt;基準は last_comment_reply_at（独り言と別）&lt;br&gt;成功時はそのセッションを予約として返す&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="2090" width="400" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="b2_comment_gen" value="&lt;b&gt;入力モデレーション → 配信状態を再確認&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;終了時は通常受付の条件を満たすなら通常チャットへ&lt;br&gt;入れ替わった配信には古い予約を使わない&lt;/span&gt;&lt;br&gt;&lt;b&gt;handle_comment(claimed_session=...)&lt;/b&gt;&lt;br&gt;受付済みなら枠を二重に取らない&lt;br&gt;ペルソナ＋履歴＋コメントで Gemini 生成&lt;br&gt;（画像対応・検索はサーバー設定に従う）&lt;br&gt;→ 感情タグ除去 → screen_bot_response()&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※長期記憶・親密度・👍👎 は使わない&lt;br&gt;※画像のみなら AUTONOMOUS_IMAGE_ONLY_COMMENT&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="2310" width="400" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="b2_dec_alive" value="&lt;b&gt;_is_current_session()&lt;/b&gt;&lt;br&gt;&lt;b&gt;まだ同じ配信が続いているか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（生成中に /leave されうる）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B85450;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="2590" width="400" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b2_comment_send" value="&lt;b&gt;send_long_reply() で返信&lt;/b&gt;&lt;br&gt;session.last_spoke_at を更新&lt;br&gt;→ MessageHandler が play_tts_response で読み上げへ回す" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="2780" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b2_comment_skip" value="&lt;b&gt;この1件は応答しない&lt;/b&gt;&lt;br&gt;・クールダウン中（前回応答から10秒未満）&lt;br&gt;・生成中に配信が終了した&lt;br&gt;・ペルソナ未読込 / 本文も画像も無い&lt;br&gt;・生成失敗 / 感情タグ除去後に本文が空&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※無応答タイマー(last_human_at)は&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;mark_activity が既に更新済みなので&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;配信が早く終わることはない&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
