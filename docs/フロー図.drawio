                <mxCell id="a2_b_handle" value="&lt;b&gt;handle_chat_message()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;channel.typing() 開始&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;load_image_attachments()&lt;br&gt;記憶は非同期一括取得（JSONは1回）&lt;br&gt;本文が空なら定型の質問文へ差し替え&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
