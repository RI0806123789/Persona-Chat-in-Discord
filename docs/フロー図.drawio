                </mxCell>
                <mxCell id="b1_handle_chat" value="&lt;b&gt;handle_chat_message()&lt;/b&gt;&lt;br&gt;通常のチャット応答&lt;br&gt;記憶・親密度・👍👎 あり" style="shape=process;size=0.06;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1730" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_resp" value="&lt;b&gt;response_text あり?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1910" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_tts" value="&lt;b&gt;play_tts_response()&lt;/b&gt;&lt;br&gt;ボイス接続中のみ読み上げ&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※未接続なら no-op（チャットは成功）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="2070" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_end" value="&lt;b&gt;終了&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="2250" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b1_unsupported" value="&lt;b&gt;「未対応の添付ファイルが含まれています」と返信&lt;/b&gt;&lt;br&gt;pdf / txt / csv / md のみ対応&lt;br&gt;→ 終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="350" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_oversize" value="&lt;b&gt;「ファイルサイズが上限を超えています」&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;MAX_DOCUMENT_SIZE_BYTES = 5MB&lt;/span&gt;&lt;br&gt;→ 終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="520" width="340" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_doc" value="&lt;b&gt;文書ワーカーへキュー登録&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;documents.enqueue_from_message()&lt;/span&gt;&lt;br&gt;「受付が完了しました」と返信&lt;br&gt;→ 常駐ワーカーが後で回答（非同期）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
