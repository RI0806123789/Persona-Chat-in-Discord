    <diagram id="pageB1" name="B-1 on_message パイプライン">
        <mxGraphModel dx="1075" dy="843" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="2700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="b1_ttl" value="B-1 on_message パイプライン（6段階の関門）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="10" width="1200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="b1_start" value="&lt;b&gt;on_message 受信&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="60" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_bot" value="&lt;b&gt;client.user が未確定（ログイン前）&lt;br&gt;または送信者がボットか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="180" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_resolve" value="&lt;b&gt;サーバー設定を解決&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;guild_id = message.guild.id if message.guild else None&lt;br&gt;state.get_guild(guild_id)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※DM は全DM共有スロット&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="340" width="380" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="b1_mark" value="&lt;b&gt;会話の活動を観測（ゲートより前に呼ぶ）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;auto_topic.mark_activity()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.mark_activity()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※ボット宛てでない発言も記録する&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="440" y="500" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_gate" value="&lt;b&gt;関門① 応答モードのゲート&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;accepts_normally?&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;DM / mention以外のモード / メンションあり&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="670" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_comment" value="&lt;b&gt;【例外】配信中のコメント欄か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.is_comment_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※メンション不要で拾う&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="860" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_black" value="&lt;b&gt;関門② ブラックリスト&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;blacklist.is_blocked()&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1040" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_empty" value="&lt;b&gt;本文をクリーニングした結果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;clean_message_content()&lt;/span&gt;&lt;br&gt;&lt;b&gt;本文も添付も空か?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1210" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_channel" value="&lt;b&gt;返信・履歴取得ができる種別か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;is_supported_message_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※Gemini を無駄打ちしないため関門③の前に置く&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1400" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_ng" value="&lt;b&gt;関門③ NGワードフィルタ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;ng_filter.contains_ng_word()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※本文があるときだけ判定する&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1590" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_mod" value="&lt;b&gt;配信コメントは claim_comment_slot() で受付&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;枠なしなら return（活動観測は済んでいる）&lt;/span&gt;&lt;br&gt;&lt;b&gt;関門④ 3つの判定を Gemini 1回で&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;content_moderator.check_and_route()&lt;/span&gt;&lt;br&gt;モデレーション＋記憶ルーティング＋リマインダー抽出&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※本文があるときだけ呼ぶ / 例外・タイムアウト・JSONパース失敗は safe 扱い&lt;br&gt;※安全フィルタ・テキスト取得失敗は unsafe 扱い&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2A55;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1780" width="380" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_safe" value="&lt;b&gt;is_safe ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="1980" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_conn_a" value="&lt;b&gt;①&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="440" y="2140" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b1_ignore_bot" value="&lt;b&gt;return（未ログイン / ボットの発言は処理しない）&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="180" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_ignore" value="&lt;b&gt;黙って破棄（return）&lt;/b&gt;&lt;br&gt;・ゲート不成立かつ配信中でない&lt;br&gt;・ブラックリスト登録済み&lt;br&gt;・本文も添付も空&lt;br&gt;・返信できないチャンネル種別" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1100" width="300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="b1_violation" value="&lt;b&gt;notify_violation()&lt;/b&gt;&lt;br&gt;違反を1回記録し警告を返信&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;blacklist.record_violation()&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1780" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_violation" value="&lt;b&gt;違反が3回目か?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;BLACKLIST_MAX_VIOLATIONS = 3&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B85450;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1950" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_blocked" value="&lt;b&gt;ブラックリストに登録&lt;/b&gt;&lt;br&gt;「以降のメッセージは無視されます」&lt;br&gt;と返信して終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2120" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_warn" value="&lt;b&gt;「あと◯回で応答を停止します」&lt;/b&gt;&lt;br&gt;と警告して終了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7A1F1C;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2290" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_conn_b" value="&lt;b&gt;①&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontColor=#333333;fontSize=13;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="60" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="b1_touch" value="&lt;b&gt;最終活動時刻を更新 / 監視対象に登録&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;state.touch()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;auto_topic.watch_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※DM と配信中のコメント欄は登録しない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="190" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_attach" value="&lt;b&gt;添付ファイルの種別は?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（多分岐）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="350" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_stats" value="&lt;b&gt;spawn(stats.record(...))&lt;/b&gt;&lt;br&gt;会話統計を fire-and-forget で記録&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※opt-out 判定は StatsService の内部で行う&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#2D5016;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="540" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_reminder" value="&lt;b&gt;関門⑤ リマインダー依頼が&lt;br&gt;抽出されていたか?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（関門④ の戻り値 reminder）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="710" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b1_reminder" value="&lt;b&gt;reminders.create_from_request()&lt;/b&gt;&lt;br&gt;日時の解釈・過去/上限の検証&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;REMINDER_MAX_PENDING_PER_USER = 20&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="880" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_reminder_ok" value="&lt;b&gt;確認文（戻り値）が返ったか?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1040" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_recheck" value="&lt;b&gt;関門⑥ 配信中かを取り直す&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;autonomous.is_comment_channel()&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;※モデレーション中に配信が終わりうるため&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;入口の判定を再利用しない&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#1A1A1A;fontSize=12;fontFamily=Meiryo UI;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1200" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_comment2" value="&lt;b&gt;いま配信中か?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="1390" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b1_dec_normal" value="&lt;b&gt;accepts_normally ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666&quot;&gt;（DM / 全発言モード / メンションあり）&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7F6000;fontSize=12;fontFamily=Meiryo UI;" parent="1" vertex="1">
