# --- Secrets: NEVER commit these ---
config_private.py
*.env
.env

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- 仮想環境 (python -m venv で作成) ---
.venv/
venv/

# --- Temp files generated by the bot at runtime ---
# 読み上げは音声をメモリ上だけで扱うようになったため、現在は生成されない
# （FFmpeg を使っていた頃の一時 mp3。古い環境に残っている分を無視する）。
temp_speech_*.mp3

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Third-party binaries: too large for git (avcodec-62.dll alone is
#     ~100MB, over GitHub's single-file limit). ---
#     FFmpeg はもう不要（読み上げは miniaudio がメモリ上で PCM 変換する）。
#     以前 index/ に配置していた場合、これらは削除してよい。
#     誤ってコミットされないよう無視設定だけは残しておく。
ffmpeg-master-latest-win64-gpl-shared/
ffmpeg.exe
ffplay.exe
ffprobe.exe
*.dll


# --- Runtime memory files ---
memory/*
!memory/.gitkeep
*temp

# --- NG ---
NG_WORD_private.txt
# 違反記録（実ユーザーの Discord ID・ユーザー名を含むランタイムデータ）
ng/blacklist.json

# ---dev---
memo/
chatlog/
assets/


